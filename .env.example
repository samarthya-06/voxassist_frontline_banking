# Docker MongoDB Credentials
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=password123

# Docker Mongo Express Credentials (for the UI dashboard at :8081)
MONGO_EXPRESS_USERNAME=admin
MONGO_EXPRESS_PASSWORD=password123

# Backend: Authentication
JWT_SECRET=change-this-in-production

# Backend: AI APIs
SARVAM_API_KEY=
GEMINI_API_KEY=

# Backend: Database Configuration
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=voxassist

# Backend: RAG & Knowledge Base Configuration
CHROMA_PERSIST_DIR=.chroma
KB_DATA_DIR=backend/data/kb
DEFAULT_BRANCH_ID=default
RAG_TOP_K=5
RAG_MIN_CONFIDENCE=0.18
RAG_USE_LLM=false
AI_FAST_MODE=true

# Backend: Server Configuration
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Backend: Fonts
DEVANAGARI_FONT_PATH=
