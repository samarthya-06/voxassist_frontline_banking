# Copy this to a private notes file and fill it in before deploying.
# Do not commit real secrets.

AWS_REGION=ap-south-1
AWS_FRONTEND_BUCKET=voxassist-app-your-name
AWS_CLOUDFRONT_DISTRIBUTION_ID=

FRONTEND_DOMAIN=app.yourdomain.com
API_DOMAIN=api.yourdomain.com
CERTBOT_EMAIL=you@example.com

EC2_ELASTIC_IP=
EC2_KEY_PATH=~/Downloads/voxassist-key.pem

MONGODB_URI=mongodb+srv://voxassist:PASSWORD@cluster0.xxxxx.mongodb.net/voxassist?retryWrites=true&w=majority
SARVAM_API_KEY=
GEMINI_API_KEY=
JWT_SECRET=replace-with-a-long-random-secret-minimum-32-chars
