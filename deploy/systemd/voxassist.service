[Unit]
Description=VoxAssist FastAPI Backend
After=network.target

[Service]
Type=exec
User=ec2-user
WorkingDirectory=/home/ec2-user/voxassist
EnvironmentFile=/home/ec2-user/voxassist/backend/.env
Environment=PATH=/home/ec2-user/voxassist/.venv/bin:/usr/bin:/bin
ExecStart=/home/ec2-user/voxassist/.venv/bin/uvicorn backend.app.main:app --host 127.0.0.1 --port 8000 --workers 2
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
